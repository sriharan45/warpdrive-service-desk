# WarpDrive Intelligent Service Desk - Backend Environment Variables
ENVIRONMENT=development

# Database Connection (Neon PostgreSQL in production, SQLite fallback for local development)
DATABASE_URL=postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/warpdrive?sslmode=require

# JWT Authentication
JWT_SECRET=replace-with-a-random-secure-64-character-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API (Optional backend-only conversational enhancement; deterministic fallback active if unset)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration
FRONTEND_URL=http://localhost:5173
